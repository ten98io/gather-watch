{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "API_PORT",
        "MEDIA_PORT",
        "MONGO_URL",
        "REDIS_URL",
        "ADMIN_EMAILS",
        "APP_URL",
        "API_URL",
        "JWT_SECRET",
        "JWT_REFRESH_SECRET",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USER",
        "SMTP_PASS",
        "SMTP_FROM",
        "LIVEKIT_URL",
        "LIVEKIT_INTERNAL_URL",
        "LIVEKIT_API_KEY",
        "LIVEKIT_API_SECRET",
        "TURN_STATIC_AUTH_SECRET",
        "S3_ENDPOINT",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "S3_PUBLIC_BASE_URL",
        "FFMPEG_PATH",
        "STORAGE_QUOTA_GB",
        "CF_TURN_KEY_ID",
        "CF_TURN_API_TOKEN",
        "CF_SFU_APP_ID",
        "CF_SFU_API_TOKEN",
        "FREE_TURN_CAP_GB_PER_MONTH",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_PRICE_PREMIUM_MONTHLY",
        "ENABLE_MEDIA_PIPELINE",
        "ENABLE_SFU",
        "TENOR_API_KEY",
        "VAPID_PUBLIC_KEY",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT",
        "RATE_LIMIT_MAX",
        "RATE_LIMIT_WINDOW_MS",
        "RATE_LIMIT_AUTH_MAX",
        "NEXT_PUBLIC_API_URL"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}

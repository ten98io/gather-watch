# ── App ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
NODE_ENV=development

# ── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-64-random-chars
JWT_REFRESH_SECRET=change-me-too-64-random-chars
MAGIC_LINK_TTL_MIN=15

# Email transport for magic links. In development, leave SMTP_HOST empty:
# links are printed to the API log and surfaced in the dev UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Playin <no-reply@playin.local>

# ── Data stores (empty ⇒ in-memory adapters; fine for dev, not prod) ──
MONGO_URL=
REDIS_URL=

# ── LiveKit (media plane) ─────────────────────────────────────────────
# LIVEKIT_URL is the PUBLIC client URL (wss:// in production).
# LIVEKIT_INTERNAL_URL is what the API uses for server-side admin/token
# calls; docker compose overrides it to http://livekit:7880 in-network.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_INTERNAL_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-at-least-32-characters-long

# ── TURN (coturn relay for clients behind hostile NATs) ───────────────
# REQUIRED for `docker compose up` (compose fails without it — no insecure
# fallback). The API mints time-limited HMAC TURN credentials from this
# same secret (coturn REST convention). Use a long random string.
TURN_STATIC_AUTH_SECRET=

# ── Object storage (MinIO / any S3) ───────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=playin
S3_SECRET_KEY=playin-secret
S3_BUCKET=playin-media
S3_PUBLIC_BASE_URL=http://localhost:9000/playin-media

# ── Media pipeline ────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
STORAGE_QUOTA_GB=10

# ── Cloudflare Realtime (TURN fallback + premium SFU) ─────────────────
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
CF_SFU_APP_ID=
CF_SFU_API_TOKEN=
FREE_TURN_CAP_GB_PER_MONTH=20

# ── Billing (Stripe) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=

# ── Optional deploy flags ─────────────────────────────────────────────
ENABLE_MEDIA_PIPELINE=false
ENABLE_SFU=false

# ── Owner ops console (/admin) ────────────────────────────────────────
# Comma-separated verified account emails that may read ops telemetry and
# resolve abuse reports. Empty = the /admin surface is closed to everyone.
ADMIN_EMAILS=

# ── Integrations (optional) ───────────────────────────────────────────
TENOR_API_KEY=

# ── Web push (generate with: pnpm --filter api generate:vapid) ────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@playin.local

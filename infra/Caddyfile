# ── Gather — Caddy reverse proxy ──────────────────────────────────────────────
# Replace gather.example.com with your real domain (DNS A/AAAA → this host).
# Caddy auto-provisions and renews Let's Encrypt certificates — no manual cert
# work needed as long as ports 80 and 443 are reachable from the internet.

gather.example.com {
	encode zstd gzip

	# ── API: REST + the multiplexed room WebSocket ─────────────────────────
	# Caddy proxies WebSocket upgrades transparently — no extra config needed.
	# Routes are proxied with their prefix intact (the API serves /api/* and
	# /ws itself; adjust with `uri strip_prefix` only if the API expects bare
	# paths).
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /ws* {
		reverse_proxy api:4000
	}

	# ── Public media (MinIO S3) ────────────────────────────────────────────
	# https://gather.example.com/media/<bucket>/<key>  →  minio:9000/<bucket>/<key>
	# e.g. S3_PUBLIC_BASE_URL=https://gather.example.com/media/gather-media
	handle /media/* {
		uri strip_prefix /media
		reverse_proxy minio:9000
	}

	# ── Everything else: Next.js web app ──────────────────────────────────
	handle {
		reverse_proxy web:3000
	}
}

# ── Local development block (plain HTTP, no certs) ───────────────────────────
# Reachable at http://localhost:8080 (compose publishes 8080). The explicit
# http:// prefix stops Caddy from minting an internal TLS cert for localhost.
http://localhost:8080 {
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /ws* {
		reverse_proxy api:4000
	}
	handle /media/* {
		uri strip_prefix /media
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy web:3000
	}
}

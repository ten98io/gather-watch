{
  "name": "@gather/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "build:prod": "GATHER_BUILD=prod tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "tokens:generate": "UPDATE_TOKENS=1 vitest run test/design-tokens.test.ts"
  },
  "dependencies": {
    "@gather/api-client": "workspace:*",
    "@gather/contracts": "workspace:*",
    "@gather/p2p": "workspace:*",
    "@gather/sync-core": "workspace:*"
  },
  "devDependencies": {
    "@gather/design": "workspace:*",
    "@types/chrome": "^0.2.6",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}

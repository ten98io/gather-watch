# ── App ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
NODE_ENV=development

# ── Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-64-random-chars
JWT_REFRESH_SECRET=change-me-too-64-random-chars
MAGIC_LINK_TTL_MIN=15

# Magic-link delivery. Three transports, tried in this order:
#   1. Cloudflare Email Service REST API — needs BOTH CF_EMAIL_ACCOUNT_ID and
#      CF_EMAIL_API_TOKEN (Workers Paid plan). Either one alone is ignored.
#   2. SMTP — used when SMTP_HOST is set.
#   3. Neither set: the link is printed to the API log and surfaced in the dev
#      UI. This is the local development sign-in flow.
# A CONFIGURED transport that fails makes POST /auth/magic-link answer 500 —
# never a silent "check your email" for a mail that never went out.
#
# CF_EMAIL_API_TOKEN and SMTP_PASS are SECRETS: set them from your platform's
# secret store, never commit a real value.
CF_EMAIL_ACCOUNT_ID=
CF_EMAIL_API_TOKEN=
CF_EMAIL_FROM=Gather <no-reply@gather.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Gather <no-reply@gather.local>

# ── Data stores (empty ⇒ in-memory adapters; fine for dev, not prod) ──
MONGO_URL=
REDIS_URL=

# ── TURN (optional coturn REST fallback) ──────────────────────────────
# Cloudflare TURN (CF_TURN_* below) is the production relay. Set this only
# if you run your OWN external coturn: the API mints time-limited HMAC
# credentials from this secret (coturn REST convention) when Cloudflare
# TURN is not configured. Empty ⇒ that strategy is skipped (STUN-only
# fallback). Use a long random string.
TURN_STATIC_AUTH_SECRET=

# ── Object storage (MinIO / any S3) ───────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=gather
S3_SECRET_KEY=gather-secret
S3_BUCKET=gather-media
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/gather-media
# Addressing: path-style is /bucket/key (MinIO), virtual-hosted is
# bucket.host/key (Railway/Tigris, AWS, R2). Left empty it is derived from
# S3_ENDPOINT; set true/false only to override that.
S3_FORCE_PATH_STYLE=
#
# Railway Buckets: link the bucket and set NOTHING above — a linked bucket
# injects BUCKET / ACCESS_KEY_ID / SECRET_ACCESS_KEY / REGION / ENDPOINT and
# those are read as an alternative source for the same settings (any S3_* you
# do set wins). Addressing resolves to virtual-hosted and the region to 'auto'.
# A Railway bucket is PRIVATE by default, so the derived public base
# (https://<bucket>.<endpoint-host>) returns 403 until the bucket is made
# public — put a CDN in front and set S3_PUBLIC_BASE_URL, or serve objects
# through presigned GETs.
# Setting SOME storage vars and not others is a boot error, never a partial
# config: endpoint, bucket, access key and secret key must all be present.

# ── Media pipeline ────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
STORAGE_QUOTA_GB=10

# ── Cloudflare Realtime (TURN fallback + premium SFU) ─────────────────
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
CF_SFU_APP_ID=
CF_SFU_API_TOKEN=
FREE_TURN_CAP_GB_PER_MONTH=20

# ── Billing (Stripe) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=

# ── Optional deploy flags ─────────────────────────────────────────────
ENABLE_MEDIA_PIPELINE=false

# ── Owner ops console (/admin) ────────────────────────────────────────
# Comma-separated verified account emails that may read ops telemetry and
# resolve abuse reports. Empty = the /admin surface is closed to everyone.
ADMIN_EMAILS=

# ── Integrations (optional) ───────────────────────────────────────────
TENOR_API_KEY=

# ── Web push (generate a key pair with: npx web-push generate-vapid-keys) ─
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@gather.local

# ── Gather — Caddy reverse proxy ──────────────────────────────────────────────
# Replace gather.example.com with your real domain (DNS A/AAAA → this host).
# Caddy auto-provisions and renews Let's Encrypt certificates — no manual cert
# work needed as long as ports 80 and 443 are reachable from the internet.

gather.example.com {
	encode zstd gzip

	# ── API: REST + the multiplexed room WebSocket ─────────────────────────
	# Caddy proxies WebSocket upgrades transparently — no extra config needed.
	#
	# THE PREFIX IS STRIPPED, and it has to be. The API mounts every module at
	# a BARE path — `services/api/src/app.ts` registers each one with
	# `app.register(mod.routes)` and no prefix, and `/healthz` is bare too — so
	# a request forwarded as `/api/healthz` 404s at the API, and so does every
	# REST call. `/api` exists only so one domain can carry both halves of the
	# product; it is this proxy's word, never the API's.
	#
	# The web app is built with `NEXT_PUBLIC_API_URL=https://<domain>/api`, and
	# `apps/web/lib/api.ts` derives the socket URL from it as
	# `<base>/ws` — so the room socket arrives here as `/api/ws` and is
	# stripped to `/ws` by this same block. The bare `/ws*` block below is for
	# a client configured to reach the API directly rather than through `/api`.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:4000
	}
	handle /ws* {
		reverse_proxy api:4000
	}

	# ── Public media (MinIO S3) ────────────────────────────────────────────
	# https://gather.example.com/media/<bucket>/<key>  →  minio:9000/<bucket>/<key>
	#
	# Reachable but currently UNUSED by the product: `S3_PUBLIC_BASE_URL` is
	# parsed into `AppConfig` and read by no code path — chat attachments are
	# served through the API's own capability route
	# (`GET /assets/:assetId/content` → a short-lived presigned GET), which
	# keeps the bucket private. Kept because a self-hoster pointing a browser
	# at their own bucket is a reasonable thing to want; delete both this block
	# and the variable if you never will.
	handle /media/* {
		uri strip_prefix /media
		reverse_proxy minio:9000
	}

	# ── Everything else: Next.js web app ──────────────────────────────────
	handle {
		reverse_proxy web:3000
	}
}

# ── Local development block (plain HTTP, no certs) ───────────────────────────
# Reachable at http://localhost:8080 (compose publishes 8080). The explicit
# http:// prefix stops Caddy from minting an internal TLS cert for localhost.
http://localhost:8080 {
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:4000
	}
	handle /ws* {
		reverse_proxy api:4000
	}
	handle /media/* {
		uri strip_prefix /media
		reverse_proxy minio:9000
	}
	handle {
		reverse_proxy web:3000
	}
}

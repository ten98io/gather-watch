{
  "name": "@playin/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync('dist',{recursive:true});for(const f of fs.readdirSync('public'))fs.copyFileSync(p.join('public',f),p.join('dist',f));\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@playin/api-client": "workspace:*",
    "@playin/contracts": "workspace:*",
    "@playin/p2p": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
